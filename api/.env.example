# Backend API Environment Variables (configure in Render / Railway Environment tab)

# PostgreSQL connection string (managed Postgres e.g. Neon or Supabase)
ConnectionStrings__Default=Host=ep-xyz.region.aws.neon.tech;Database=campuseats;Username=neondb_owner;Password=your_db_password;SSL Mode=Require;Trust Server Certificate=true

# JWT Authentication Configuration
Jwt__Key=your-very-strong-production-random-secret-key-min-32-chars
Jwt__Issuer=CampusEats
Jwt__Audience=CampusEatsUsers

# Platform Port (typically assigned automatically by Render / Railway via ASPNETCORE_URLS or PORT)
ASPNETCORE_URLS=http://0.0.0.0:8080
